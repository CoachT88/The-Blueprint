{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-blueprint",
  "keep_vars": true,
  "vars": {
    "STRIPE_PRICE_CENTS": "9900"
  },
  "main": "src/worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
