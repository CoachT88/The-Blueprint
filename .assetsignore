# Files that live in the repo but must never be served to visitors.
# wrangler.jsonc sets assets.directory to the repo root, so without this
# every source file here is a fetchable URL on the live site.

node_modules
.git
.github
.claude

# Backend source and schema. None of it holds secrets, but published it is
# a free map of the backend for anyone probing the site.
functions
supabase
src

# A second product's entire source tree, which lives in this repo for reasons
# that have nothing to do with The Blueprint. Without this line it is served
# from The Blueprint's own domain: /harmonymap/package.json, /harmonymap/src/,
# /harmonymap/vite.config.js and the rest are all fetchable URLs on the live
# site. Getting it out of the repo is the real fix. This stops the bleeding.
harmonymap

# Tests and tooling, not site content. img/ is deliberately absent from this
# list: the screenshots and the link-preview card have to be fetchable.
tests
tools
vitest.config.js
package.json
package-lock.json
wrangler.jsonc
vercel.json
.assetsignore
.gitignore
